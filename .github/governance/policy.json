{
  "version": "pr-governance/v3",
  "mode": "enforce",
  "review_routing": {
    "dispatch_mentions": [
      "@codex review",
      "@claude review"
    ]
  },
  "r0_paths": [
    "README.md",
    "README.zh-CN.md",
    "profile/README.md"
  ],
  "r2_paths": [
    "actions/",
    "scripts/",
    ".github/governance/",
    ".github/scripts/",
    "workflow-templates/"
  ],
  "dependabot_template_exemption": true,
  "max_evidence_age_hours": 168
}
